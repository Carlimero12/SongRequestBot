<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>SongRequestBot</PackageId>
    <Version>1.0.0</Version>
    <Authors>Carlimero12; N1ghtTheF0x; JorgenTheHorg</Authors>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis" Version="1.76.0" />
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.76.0.4262" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <PackageReference Include="NetCord" Version="1.0.0-beta.28" />
    <PackageReference Include="NetCord.Services" Version="1.0.0-beta.28" />
    <PackageReference Include="TwitchLib" Version="3.5.3" />
    <PackageReference Include="TwitchLib.Client" Version="4.0.1" />
  </ItemGroup>

</Project>
